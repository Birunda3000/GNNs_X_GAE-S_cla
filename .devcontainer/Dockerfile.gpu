# .devcontainer/Dockerfile.gpu
FROM nvcr.io/nvidia/pytorch:26.05-py3

RUN [ -f /etc/pip/constraint.txt ] && > /etc/pip/constraint.txt || true

ENV LD_LIBRARY_PATH="/usr/lib/wsl/lib:${LD_LIBRARY_PATH}"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True,max_split_size_mb:512"

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    ninja-build \
    cmake \
    libnuma-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instalação do Node.js, Pi Agent, Extensões e Skills
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g --ignore-scripts @earendil-works/pi-coding-agent && \
    pi install npm:pi-rtk-optimizer && \
    pi install npm:@dietrichgebert/ponytail && \
    pi install npm:pi-subagents && \
    pi install npm:pi-memory && \
    pi install npm:pi-deepseek-search && \
    pi install npm:pi-web-access && \
    pi install npm:@alexanderfortin/pi-deepseek-usage && \
    npx skills add mattpocock/skills --skill=grill-me -y -g

RUN pip install --no-cache-dir --upgrade pip wheel setuptools

# Instalação Limpa do PyTorch Geometric
RUN pip install --no-cache-dir \
    torch_geometric \
    triton \
    numba \
    scipy \
    networkx

# Instalação do RAPIDS via NVIDIA Index (Pacotes CUDA 13)
RUN pip install --no-cache-dir \
    cugraph-cu13 \
    cugraph-pyg-cu13 \
    --extra-index-url=https://pypi.nvidia.com

WORKDIR /app/gnn_tcc
COPY .devcontainer/requirements.txt .

RUN pip install --no-cache-dir --default-timeout=100 --ignore-installed Pygments -r requirements.txt

ENV PATH="/usr/local/bin:${PATH}"
CMD ["/bin/bash", "-c", "while true; do sleep infinity; done"]